{
  "id": "wf-03-analytics-digest",
  "name": "03 - Analytics Digest",
  "nodes": [
    {
      "id": "schedule_daily",
      "name": "Every Day 9am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-200, 300],
      "parameters": {
        "rule": { "interval": [{ "field": "days", "triggerAtHour": 9 }] }
      }
    },
    {
      "id": "http_get_analytics",
      "name": "Get Analytics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [40, 300],
      "parameters": {
        "method": "GET",
        "url": "={{$env.BACKEND_BASE_URL}}/api/analytics",
        "options": {}
      }
    },
    {
      "id": "code_format",
      "name": "Format Digest Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [280, 300],
      "parameters": {
        "jsCode": "const a = items[0].json;\nconst text = `AI Business Operations Hub — Daily Digest\\n\\nRequests processed: ${a.requests_processed}\\nAutomation rate: ${a.automation_rate}%\\nAvg AI cost: €${a.average_ai_cost}\\nEst. hours saved (month): ${a.estimated_hours_saved_month}\\nEst. saving (month): €${a.estimated_saving_month_eur}\\nWorkflow success: ${a.workflow_success_rate}%\\n\\n(${a.note})`;\nreturn [{ json: { text } }];"
      }
    },
    {
      "id": "http_notify_slack",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/api/notify/slack",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { text: $json.text } }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every Day 9am": {
      "main": [[{ "node": "Get Analytics", "type": "main", "index": 0 }]]
    },
    "Get Analytics": {
      "main": [[{ "node": "Format Digest Message", "type": "main", "index": 0 }]]
    },
    "Format Digest Message": {
      "main": [[{ "node": "Notify Slack", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
