# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Database ---
POSTGRES_USER=hub
POSTGRES_PASSWORD=hub
POSTGRES_DB=business_ops_hub
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://hub:hub@localhost:5432/business_ops_hub

# --- Backend ---
BACKEND_PORT=8000
CONFIDENCE_THRESHOLD=0.90

# --- SMTP (optional — leave blank to keep using the simulated mock) ---
# Gmail: generate an "app password" at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the account).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=AI Business Operations Hub

# --- n8n ---
N8N_PORT=5679
BACKEND_BASE_URL=http://backend:8000
